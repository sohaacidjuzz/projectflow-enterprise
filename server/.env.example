# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://projectflow:projectflow@localhost:5432/projectflow?schema=public

# Authentication - use a long random value outside local development
JWT_SECRET=change-this-to-a-long-random-secret

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# CORS for local Angular development
CLIENT_ORIGIN=http://localhost:4200

# Local/demo seed account. Never use these defaults in production.
SEED_ADMIN_NAME=ProjectFlow Admin
SEED_ADMIN_EMAIL=admin@projectflow.dev
SEED_ADMIN_PASSWORD=Admin@123
